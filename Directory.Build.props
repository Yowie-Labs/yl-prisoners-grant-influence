<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Skaldflow.Workspace\Skaldflow.Workspace.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Skaldflow.Workspace\Skaldflow.Workspace.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <BannerCordPackageSource Condition="'$(BannerCordPackageSource)' == '' and '$(BANNERCORD_NUGET_FEED)' != ''">$(BANNERCORD_NUGET_FEED)</BannerCordPackageSource>
    <BannerCordPackageSource Condition="'$(BannerCordPackageSource)' == ''">$(MSBuildThisFileDirectory)..\Bannercord.Core\artifacts\packages</BannerCordPackageSource>
    <RestoreAdditionalProjectSources Condition="Exists('$(BannerCordPackageSource)')">$(RestoreAdditionalProjectSources);$(BannerCordPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <Target Name="EnsureBannerlordGameRootForLordsGrantInfluence" BeforeTargets="ResolveReferences">
    <Error Condition="'$(BannerlordGameRoot)' == '' or !Exists('$(BannerlordGameRoot)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll')"
           Text="YL.Prisoners.LordsGrantInfluence could not resolve BannerlordGameRoot. Configure Skaldflow.Workspace\Skaldflow.Workspace.local.props or add Directory.Build.props.user." />
  </Target>
</Project>
