{
  // Repository-owned snapshot overrides. SAFE TO CUSTOMIZE.
  // Package runtime defaults update independently; prefer additionalIncludeGlobs/additionalExcludeGlobs to extend them.
  // Explicit includeGlobs/excludeGlobs, when present, intentionally replace package defaults.
"schemaVersion": 1,
  "repoName": "YL.Prisoners.LordsGrantInfluence",
  "projectName": "YL.Prisoners.LordsGrantInfluence",
  "snapshotNamePrefix": "YL.Prisoners.LordsGrantInfluence-snapshot",
  "includeWorkflowPackage": false,
  "includeMedia": false,
  "includeBinaryLogs": false,
  "maxSnapshotsToKeep": 5,
  "archiveOldSnapshots": true,
  "paths": {
    "targetRoot": ".",
    "runtimeRoot": "<RuntimeRoot>",
    "centralSnapshotsDir": "<RuntimeRoot>/snapshots",
    "snapshotsDir": "<RuntimeRoot>/snapshots",
    "outputDir": "<RuntimeRoot>/snapshots",
    "archiveDir": "<RuntimeRoot>/snapshots/_archive"
  },
  "includeGlobs": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONVENTIONS.md",
    ".gitignore",
    ".gitattributes",
    ".vscode/tasks.json",
    "*.sln",
    "*.csproj",
    "*.props",
    "src/**",
    "module/**",
    "config/ai-repo-workflow/**",
    "config/*.jsonc",
    "docs/**",
    "tests/**",
    "scripts/**",
    "*.md",
    "*.jsonc",
    "*.xml",
    "*.ps1"
  ],
  "excludeGlobs": [
    "repo-file-inventory.txt",
    "manifest.json",
    "tools/ai-repo-workflow/**",
    "**/bin/**",
    "**/obj/**",
    "**/artifacts/**",
    "**/.vs/**",
    "**/.git/**",
    "**/*.dll",
    "**/*.exe",
    "**/*.pdb"
  ],
  "extends": "../ai-repo-workflow.local.jsonc",
  "sourcePaths": ".",
  "additionalIncludeGlobs": null,
  "additionalExcludeGlobs": null,
  "delegateSnapshotScript": "",
  "delegateSnapshotArguments": null,
  "workspace": {
    "enabled": false,
    "includeSelfSnapshot": true,
    "projects": null
  },
  "configSchemaVersion": 2
}
