{
  // GENERATED by ai-repo-workflow. Custom edits are replaced during package updates.
  "extends": "../ai-repo-workflow.local.jsonc",
  // Machine-readable summary for local AI coding agents.
  "schemaVersion": 1,
  "workflowScaffoldVersion": 2,
  "repoName": "YL.Prisoners.LordsGrantInfluence",
  "workflowPackagePath": "<PackageRoot>",
  "defaultInstallMode": "reference",
  "targetReposVendorImplementationFilesByDefault": false,
  "agentInstructionFiles": [
    "AGENTS.md"
  ],
  "agentInstructionContract": {
    "workflowManagedBlock": [
      "<!-- ai-repo-workflow:start -->",
      "<!-- ai-repo-workflow:end -->"
    ],
    "conventionsManagedBlock": [
      "<!-- ai-repo-workflow:conventions:start -->",
      "<!-- ai-repo-workflow:conventions:end -->"
    ],
    "repositoryTextOutsideManagedBlocksIsPreserved": true,
    "profileConfig": "config/ai-repo-workflow/agent-instructions.jsonc",
    "manageCommand": "repo-tools.ps1 -Command AgentInstructions",
    "technologyDetectionIsAdvisory": true
  },
  "artifactOwnership": {
    "workflowOwned": "replaced by package updates; customize through documented extension points",
    "managedBlock": "only marked workflow blocks/entries are replaced; surrounding repository content is preserved",
    "repoOwnedConfig": "repository override/extension file; package updates preserve values and runtime defaults update independently",
    "generatedSummary": "regenerated from the current workflow package; custom edits are not preserved"
  },
  "entryPoints": {
    "applyPatch": "scripts/Invoke-RepoPatch.ps1",
    "createSnapshot": "scripts/New-RepoSnapshot.ps1",
    "createWorkspacePatchBundle": "scripts/New-WorkspacePatchBundle.ps1",
    "validateWorkspacePatchBundle": "scripts/Test-WorkspacePatchBundle.ps1",
    "watchPatches": "scripts/Watch-Patches.ps1",
    "verify": "scripts/verify.ps1"
  },
  "runtimeFolders": {
    "runtimeRoot": "<RuntimeRoot>",
    "downloads": "<RuntimeRoot>/downloads",
    "applied": "<RuntimeRoot>/downloads/applied",
    "failureDiagnostics": "<RuntimeRoot>/snapshots/<project>-patch-*-diagnostics-<timestamp>.zip",
    "snapshots": "<RuntimeRoot>/snapshots",
    "snapshotArchive": "<RuntimeRoot>/snapshots/_archive",
    "patchRunLogs": "<RuntimeRoot>/logs/patch-runs"
  },
  "patchZipRules": {
    "pathsAreRepoRelative": true,
    "outerWrapperFolderAllowed": false,
    "deleteFilesByDefault": false
  },
  "patchMetadataContract": {
    "manifestPath": ".ai-repo-workflow-patch.json",
    "schemaVersion": 2,
    "allowedRootProperties": [
      "schemaVersion",
      "workstreamId",
      "workstreamPurpose",
      "patchId",
      "targetRepository",
      "baseReference",
      "files"
    ],
    "requiredRootProperties": [
      "schemaVersion",
      "workstreamId",
      "workstreamPurpose",
      "patchId",
      "targetRepository",
      "files"
    ],
    "optionalRootProperties": [
      "baseReference"
    ],
    "additionalRootPropertiesAllowed": false,
    "rootPropertyConstraints": {
      "schemaVersion": { "const": 2 },
      "workstreamId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "workstreamPurpose": { "type": "string", "minLength": 1 },
      "patchId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "targetRepository": { "type": "string", "minLength": 1 },
      "baseReference": { "type": "string" },
      "files": { "type": "array", "minItems": 1 }
    },
    "fileEntryContract": {
      "allowedProperties": [
        "path",
        "baseState",
        "baseSha256"
      ],
      "requiredProperties": [
        "path",
        "baseState"
      ],
      "additionalPropertiesAllowed": false,
      "propertyConstraints": {
        "path": { "type": "string", "minLength": 1 },
        "baseState": { "enum": [ "absent", "file", "directory" ] },
        "baseSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      },
      "baseStates": {
        "file": { "baseSha256": "required" },
        "directory": { "baseSha256": "required" },
        "absent": { "baseSha256": "forbidden" }
      }
    },
    "manualPatchExample": {
      "schemaVersion": 2,
      "workstreamId": "EXAMPLE-A",
      "workstreamPurpose": "Implement the example feature",
      "patchId": "example-patch-001",
      "targetRepository": "ExampleRepo",
      "baseReference": "ExampleRepo-snapshot-20260813-120000",
      "files": [
        {
          "path": "src/Example.cs",
          "baseState": "file",
          "baseSha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        },
        {
          "path": "tests/Example.Tests.cs",
          "baseState": "absent"
        }
      ]
    }
  },
  "concurrencyContract": {
    "defaultMode": "optimistic-base-hash",
    "ordinaryPatchRequiresActiveWorkRecord": false,
    "ordinaryPatchRequiresLease": false,
    "explicitReservationsBlockOnlyOverlappingPaths": true,
    "preLeaseDecision": {
      "hardSignals": [
        "coordinated multi-repository implementation",
        "shared/public API, protocol, schema, or broadly consumed contract",
        "broad rename/move/migration/generated rewrite",
        "directory-tree reservation is the only honest scope"
      ],
      "otherwiseReserveWhenAtLeastTwo": [
        "more than roughly six implementation files",
        "more than two subsystems/directories",
        "another active workstream is nearby",
        "verification/manual testing is expensive",
        "rebase would substantially recreate generated/mechanical work"
      ],
      "userMustPredictTaskDuration": false,
      "planReportsPreLeaseDecision": true,
      "whenTriggered": "after plan approval, apply one control-only reservation before editing; then continue the approved plan without replanning"
    },
    "stalePatchRecovery": {
      "rejectBeforeWrites": true,
      "diagnosticIncludesExpectedAndCurrentTargetState": true,
      "diagnosticIncludesCurrentPatchTargetFiles": true,
      "diagnosticIncludesCurrentFilesExplicitlyReferencedByFailureLogs": true,
      "workspaceDiagnosticIncludesMatchingRejectedChildWhenIdentifiable": true,
      "gitDiffIsRebaseAuthority": false,
      "fullSnapshotIsFallbackOnly": true,
      "agentInstruction": "Rebase this patch against the current files in the diagnostic."
    }
  },
  "workspacePatchContract": {
    "workspaceSnapshotsMayContainChildSnapshots": true,
    "defaultPatchMode": "single-repo",
    "supportsMultiRepoPatchBundleByDefault": false,
    "singleWorkspaceBundlePreferred": false,
    "applyFrom": "repo-root",
    "routingKey": "patch filename prefix",
    "mustInspectBeforeRouting": [
      "AGENTS.md",
      "config/ai-repo-workflow/patch-config.jsonc",
      "config/ai-repo-workflow/snapshot-config.jsonc",
      "repo-tools.ps1"
    ],
    "requiredPatchResponseFields": [
      "patch mode",
      "multi-repo bundle supported",
      "apply root",
      "target repo",
      "filename prefix",
      "changed files",
      "apply command",
      "verification command",
      "suggested commit message",
      "next step"
    ]
  },
  "workspacePatchManifest": {
    "schemaVersion": 1,
    "allowedProperties": [
      "schemaVersion",
      "patches"
    ],
    "childPathPattern": "patches/<child-patch-name>.zip",
    "additionalPropertiesAllowed": false,
    "createCommand": "repo-tools.ps1 -Command WorkspacePatchBundle",
    "validateCommand": "repo-tools.ps1 -Command ValidateWorkspacePatchBundle",
    "handAuthoringAllowed": false
  },
  "patchResultContract": {
    "fullyAppliedZipAction": "move-to-applied",
    "incompleteZipAction": "leave-in-downloads",
    "automaticVerifyDuringApply": false,
    "automaticPatchAfterDuringApply": false,
    "failureDiagnosticZip": "<project>-patch-<apply-failure|partial-apply>-diagnostics-<timestamp>.zip",
    "failureDiagnosticIsRepositorySnapshot": false,
    "failureDiagnosticIncludesIncomingPatch": true,
    "failureDiagnosticIncludesCurrentPatchTargetState": true,
    "failureDiagnosticIncludesCurrentPatchTargetFiles": true,
    "fullSnapshotRequiredForStalePatch": false,
    "processedStateDirectory": "<RuntimeRoot>/state/processed-patches",
    "adjacentProcessedMarkerFiles": false,
    "automaticSelectionSkipsMatchingContentHash": true,
    "changedContentAtSameFilenameIsNew": true,
    "explicitPatchPathRetriesProcessed": true,
    "workspaceChildOutcomes": [
      "AppliedSuccessfully",
      "FailedToApply",
      "NotAttempted"
    ],
    "durableBundleResult": "artifacts/diagnostics/patch-bundles/<bundle>/<timestamp>-bundle-run-summary.json",
    "latestBundleResult": "artifacts/diagnostics/latest/patch-workflow/workspace-bundle-result.json",
    "finalBannerMustBeLastWorkflowOutput": true
  },
  "snapshotContract": {
    "automaticVerify": false,
    "verificationSuppressionEnvironmentVariable": "AI_REPO_WORKFLOW_SNAPSHOT_ACTIVE",
    "include": [
      "source/docs/config/scripts",
      "agent instructions",
      "current patch-run diagnostics",
      "workspace child snapshots when workspace.enabled is true"
    ],
    "exclude": [
      "old snapshots",
      "downloaded/applied/failed patch zips",
      "historical logs"
    ]
  },
  "paths": {
    "targetRoot": "."
  }
}
