{
  "extends": "../ai-repo-workflow.local.jsonc",
  "schemaVersion": 1,
  "repoName": "YL.Prisoners.CapturedLordsGrantInfluence",
  "commands": [
    {
      "name": "clean-yl-prisoners-captured-lords-grant-influence",
      "command": "dotnet",
      "arguments": [
        "clean",
        "src/YL.Prisoners.CapturedLordsGrantInfluence.csproj",
        "-c",
        "Release",
        "-p:Platform=x64"
      ],
      "workingDirectory": ".",
      "runByDefault": true,
      "profiles": [
        "default",
        "full"
      ]
    },
    {
      "name": "build-yl-prisoners-captured-lords-grant-influence",
      "command": "dotnet",
      "arguments": [
        "build",
        "src/YL.Prisoners.CapturedLordsGrantInfluence.csproj",
        "-c",
        "Release",
        "-p:Platform=x64"
      ],
      "workingDirectory": ".",
      "runByDefault": true,
      "profiles": [
        "default",
        "full"
      ]
    }
  ],
  "paths": {
    "targetRoot": "."
  }
}























